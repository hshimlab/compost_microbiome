library(tidyverse)
library(ggthemes)
library(scales)
library(tigris)
library(sf)
library(lwgeom)
theme_set(theme_minimal(base_size = 14))
options(tigris_class = "sf")
options(tigris_use_cache = TRUE)
setwd("~/Downloads/landuse_fresno")
fresno_lu_raw <- st_read("~/Downloads/landuse_fresno/i15_LandUse_Fresno2000.shp")
ag_codes <- c("D", "V", "I", "G", "T", "F", "R", "P", "S", "C")
ag_fresno <- fresno_lu_raw %>%
filter(CLASS1 %in% ag_codes)
ag_fresno_valid <- st_make_valid(ag_fresno)
ag_points <- st_centroid(ag_fresno_valid)
ag_points$area_acres <- ag_fresno_valid$ACRES
fresno_cty <- counties(state = "CA", cb = TRUE, year = 2020) %>%
filter(NAME == "Fresno")
ag_labels <- c(
"D"  = "Deciduous",
"V"  = "Vineyard",
"F"  = "Field Crops",
"I"  = "Idle/Fallow",
"G"  = "Grain",
"S"  = "Semi-agricultural",
"C"  = "Citrus/Subtropical",
"P"  = "Pasture",
"R"  = "Rice",
"T"  = "Truck, Nursery, Berry Crops",
"U"  = "Urban",
"UL" = "Urban Landscape",
"UR" = "Rural Residential",
"UI" = "Utility Infrastructure",
"UV" = "Vacant",
"Z"  = "Water",
"NR" = "Native Riparian",
"NV" = "Native Vegetation",
"NW" = "Non-Ag Wetland"
)
ag_points$land_use_label <- ag_labels[ag_points$CLASS1]
ag_only <- ag_points %>%
filter(land_use_label %in% c(
"Deciduous",
"Vineyard",
"Field Crops",
"Idle/Fallow",
"Grain",
"Semi-agricultural",
"Citrus/Subtropical",
"Pasture",
"Rice",
"Truck, Nursery, Berry Crops"
))
library(ggpubr)
library(grid)
acreage_legend <- ggpubr::get_legend(
ggplot() +
geom_point(aes(x = 1, y = 1, size = factor(c("5000", "10000"))), shape = 21, fill = "grey50", color = "black", alpha = 0.6) +
scale_size_manual("Acreage", values = c(2, 6)) +
theme_void() +
theme(
legend.position = "right",
legend.direction = "horizontal",
legend.title = element_text(size = 8.5),
legend.text = element_text(size = 7.5),
legend.key.height = unit(0.3, "cm"),
legend.key.width = unit(0.3, "cm"),
legend.background = element_rect(fill = "#f7f7f5", color = "gray80")
)
)
ggplot() +
geom_sf(data = fresno_cty, fill = "white", color = "gray40") +
geom_sf(data = ag_only, aes(size = area_acres, fill = land_use_label),
shape = 21, color = "black", alpha = 0.6) +
geom_segment(aes(x = -119.4, y = 37.20, xend = -119.1, yend = 37.05),
color = "darkgreen", linewidth = 0.5,
arrow = arrow(length = unit(0.12, "cm"))) +
annotate("text", x = -119.85, y = 37.27, label = "Sierra National Forest",
size = 3.8, fontface = "italic", color = "darkgreen", hjust = 0) +
geom_segment(aes(x = -120.08, y = 36.92, xend = -119.78, yend = 36.78),
color = "black", linewidth = 0.5,
arrow = arrow(length = unit(0.12, "cm"))) +
annotate("text", x = -120.35, y = 36.98, label = "Fresno / Clovis",
size = 3.8, fontface = "italic", color = "black", hjust = 0) +
geom_segment(aes(x = -120.75, y = 36.15, xend = -120.55, yend = 36.26),
color = "sienna4", linewidth = 0.5,
arrow = arrow(length = unit(0.12, "cm"))) +
annotate("text", x = -121.05, y = 36.08, label = "Desert Area",
size = 3.6, fontface = "italic", color = "sienna4", hjust = 0) +
scale_size_continuous(name = NULL, range = c(1, 12)) +
scale_fill_viridis_d(name = "Agricultural Type") +
labs(title = "Agricultural Activity in Fresno County (2000)") +
coord_sf(clip = "on") +
guides(
fill = guide_legend(
title.position = "top",
title.hjust = 0.5,
override.aes = list(size = 4)
),
size = "none"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5),
legend.position = c(0.99, 0.24),
legend.direction = "vertical",
legend.box = "vertical",
legend.title = element_text(size = 8.5),
legend.text = element_text(size = 7.5),
legend.key.height = unit(0.4, "cm"),
legend.key.width = unit(0.4, "cm"),
legend.background = element_rect(fill = "#f7f7f5", color = "gray80"),
legend.spacing.y = unit(0.2, "cm"),
panel.background = element_rect(fill = "#f7f7f5", color = NA),
plot.background = element_rect(fill = "#f7f7f5", color = NA),
axis.text = element_blank(),
axis.ticks = element_blank(),
axis.title = element_blank(),
panel.grid = element_blank(),
plot.margin = margin(t = 40, r = 60, b = 40, l = 50)
) +
annotation_custom(
grob = acreage_legend,
xmin = -117.27, xmax = -119.25,
ymin = 35.35, ymax = 36.25
)
set.seed(123)
ag_half <- ag_only[sample(nrow(ag_only), nrow(ag_only) / 2), ]
acreage_legend <- ggpubr::get_legend(
ggplot() +
geom_point(aes(x = 1, y = 1, size = factor(c("5000", "10000"))), shape = 21, fill = "grey50", color = "black", alpha = 0.6) +
scale_size_manual("Acreage", values = c(2, 6)) +
theme_void() +
theme(
legend.position = "right",
legend.direction = "horizontal",
legend.title = element_text(size = 8.5),
legend.text = element_text(size = 7.5),
legend.key.height = unit(0.3, "cm"),
legend.key.width = unit(0.3, "cm"),
legend.background = element_rect(fill = "#f7f7f5", color = "gray80")
)
)
ggplot() +
geom_sf(data = fresno_cty, fill = "white", color = "gray40") +
geom_sf(data = ag_half, aes(size = area_acres, fill = land_use_label),
shape = 21, color = "black", alpha = 0.6) +
geom_segment(aes(x = -119.4, y = 37.20, xend = -119.1, yend = 37.05),
color = "darkgreen", linewidth = 0.5,
arrow = arrow(length = unit(0.12, "cm"))) +
annotate("text", x = -119.85, y = 37.27, label = "Sierra National Forest",
size = 3.8, fontface = "italic", color = "darkgreen", hjust = 0) +
geom_segment(aes(x = -120.08, y = 36.92, xend = -119.78, yend = 36.78),
color = "black", linewidth = 0.5,
arrow = arrow(length = unit(0.12, "cm"))) +
annotate("text", x = -120.35, y = 36.98, label = "Fresno / Clovis",
size = 3.8, fontface = "italic", color = "black", hjust = 0) +
geom_segment(aes(x = -120.75, y = 36.15, xend = -120.55, yend = 36.26),
color = "sienna4", linewidth = 0.5,
arrow = arrow(length = unit(0.12, "cm"))) +
annotate("text", x = -121.05, y = 36.08, label = "Desert Area",
size = 3.6, fontface = "italic", color = "sienna4", hjust = 0) +
scale_size_continuous(name = NULL, range = c(1, 12)) +
scale_fill_viridis_d(name = "Agricultural Type") +
labs(title = "Agricultural Activity in Fresno County (2000)") +
coord_sf(clip = "on") +
guides(
fill = guide_legend(
title.position = "top",
title.hjust = 0.5,
override.aes = list(size = 4)
),
size = "none"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5),
legend.position = c(0.99, 0.24),
legend.direction = "vertical",
legend.box = "vertical",
legend.title = element_text(size = 8.5),
legend.text = element_text(size = 7.5),
legend.key.height = unit(0.4, "cm"),
legend.key.width = unit(0.4, "cm"),
legend.background = element_rect(fill = "#f7f7f5", color = "gray80"),
legend.spacing.y = unit(0.2, "cm"),
panel.background = element_rect(fill = "#f7f7f5", color = NA),
plot.background = element_rect(fill = "#f7f7f5", color = NA),
axis.text = element_blank(),
axis.ticks = element_blank(),
axis.title = element_blank(),
panel.grid = element_blank(),
plot.margin = margin(t = 40, r = 60, b = 40, l = 50)
) +
annotation_custom(
grob = acreage_legend,
xmin = -117.27, xmax = -119.25,
ymin = 35.35, ymax = 36.25
)
ag_summary <- ag_only %>%
st_drop_geometry() %>%   # remove geometry for faster summarizing
group_by(land_use_label) %>%
summarise(
parcel_count = n(),
total_acres = sum(area_acres, na.rm = TRUE)
) %>%
mutate(
total_acres = round(total_acres, 1),
percent_of_ag = round((total_acres / sum(total_acres)) * 100, 2)
) %>%
arrange(desc(total_acres))
ag_summary
